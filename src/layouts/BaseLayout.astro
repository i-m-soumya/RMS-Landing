---
import '../styles/index.css';

const { title, description, canonical = 'https://restro360.tech/', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#172554" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Restro360" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://restro360.tech/og-image.svg" />
    <meta property="og:image:alt" content="Restro360 restaurant operations software" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://restro360.tech/og-image.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
        background: var(--brand-bg);
        color: var(--brand-text);
      }

      img {
        max-width: 100%;
        display: block;
      }

      button,
      input,
      textarea {
        font: inherit;
      }

      * {
        box-sizing: border-box;
      }

      .landing-body {
        font-family: Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
        background-color: #fff;
        color: #0f172a;
        overflow-x: hidden;
      }

      .landing-body main > section:not(.landing-hero) {
        position: relative;
        background: #fff !important;
        color: #0f172a;
        overflow: hidden;
      }

      .landing-body main > section:not(.landing-hero)::after {
        content: '';
        position: absolute;
        width: 360px;
        height: 360px;
        right: -180px;
        top: 12%;
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 50%;
        pointer-events: none;
      }

      .landing-hero {
        position: relative;
        isolation: isolate;
        background: #fff;
        background-image: linear-gradient(110deg, #fff 0%, #fff 52%, #eff6ff 100%);
      }

      .landing-grid-glow {
        position: absolute;
        inset: auto 0 0;
        height: 58%;
        opacity: 0.22;
        background-image: linear-gradient(rgba(59, 130, 246, 0.12) 1px, transparent 1px), linear-gradient(90deg, rgba(59, 130, 246, 0.12) 1px, transparent 1px);
        background-size: 52px 52px;
        transform: perspective(500px) rotateX(62deg) scale(1.5) translateY(28%);
        transform-origin: bottom;
        mask-image: linear-gradient(to top, black, transparent 85%);
        z-index: -1;
      }

      .landing-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #1d4ed8;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        margin-bottom: 22px;
      }

      .landing-primary-cta,
      .landing-secondary-cta {
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 22px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.01em;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;
      }

      .landing-primary-cta {
        color: #fff;
        background: #1d4ed8;
        box-shadow: none;
      }

      .desktop-nav-link {
        background: transparent;
        border: 0;
        color: #fff;
        opacity: 0.82;
      }

      .desktop-nav-link:hover,
      .desktop-nav-link:focus-visible {
        color: #ffffff;
        opacity: 1;
      }

      .landing-secondary-cta {
        color: #172554;
        border: 1px solid #cbd5e1;
        border-radius: 0.75rem;
        background: #fff;
        box-shadow: none;
      }

      .landing-stage {
        position: relative;
        min-height: 620px;
        display: flex;
        align-items: center;
        justify-content: center;
        transform-style: preserve-3d;
      }

      .landing-console {
        position: relative;
        width: min(100%, 480px);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 18px;
        overflow: hidden;
        background: #172554;
        box-shadow: 0 24px 56px rgba(23, 37, 84, 0.16);
      }

      .console-topbar {
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 16px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(0, 0, 0, 0.12);
      }

      .console-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: block;
      }

      .console-content {
        padding: 25px;
      }

      .live-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #bfdbfe;
        background: rgba(59, 130, 246, 0.15);
        border: 1px solid rgba(147, 197, 253, 0.3);
        border-radius: 999px;
        padding: 6px 9px;
        font: 500 9px 'DM Mono', monospace;
      }

      .live-pill span {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #f97316;
        box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.16);
      }

      .console-stat-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 15px;
      }

      .console-stat-grid > div {
        padding: 15px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 11px;
        background: rgba(255, 255, 255, 0.055);
      }

      .console-label {
        color: #cbd5e1;
        font-size: 10px;
        margin-bottom: 5px;
      }

      .console-number {
        color: white;
        font: 600 27px 'DM Mono', monospace;
      }

      .console-up,
      .console-muted {
        font-size: 10px;
      }

      .console-up {
        color: #fdba74;
      }

      .console-muted {
        color: #cbd5e1;
      }

      .console-order-card {
        padding: 15px;
        margin-bottom: 12px;
        border-radius: 11px;
        background: #1e3a8a;
        border: 1px solid rgba(147, 197, 253, 0.3);
      }

      .console-order-card .text-white,
      .console-order-card p,
      .console-order-card span {
        color: #f8fafc;
      }

      .table-badge {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        color: #fff;
        background: #3b82f6;
        font: 700 10px 'DM Mono', monospace;
      }

      .order-line {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #f97316;
        box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.16);
      }

      .console-menu-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 0 0;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
      }

      .menu-thumb {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #3b82f6;
      }

      .thumb-green {
        background: #f97316;
      }

      .landing-float-card {
        position: absolute;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 10px 24px rgba(23, 37, 84, 0.12);
        backdrop-filter: blur(12px);
      }

      .landing-qr-card {
        top: 17%;
        right: -2%;
        animation: float-card 5s ease-in-out infinite;
      }

      .landing-seat-card {
        bottom: 13%;
        left: -2%;
        animation: float-card 5s ease-in-out 1.3s infinite;
      }

      .seat-ring {
        display: grid;
        place-items: center;
        width: 32px;
        height: 32px;
        border: 2px solid #f97316;
        border-radius: 50%;
        color: #fdba74;
        font: 700 10px 'DM Mono', monospace;
      }

      .landing-qr-pattern {
        position: absolute;
        right: -7%;
        bottom: 25%;
        display: grid;
        place-items: center;
        width: 100px;
        height: 100px;
        color: #172554;
        background: #fff7ed;
        border-radius: 14px;
        transform: rotate(13deg);
        box-shadow: 0 10px 20px rgba(23, 37, 84, 0.12);
      }

      .landing-qr-pattern svg {
        opacity: 0.82;
      }

      .landing-orbit {
        position: absolute;
        border: 1px solid rgba(59, 130, 246, 0.24);
        border-radius: 50%;
        transform: rotate(-22deg);
      }

      .orbit-one {
        width: 590px;
        height: 210px;
      }

      .orbit-two {
        width: 500px;
        height: 160px;
        border-color: rgba(249, 115, 22, 0.15);
        transform: rotate(35deg);
      }

      .nav-shell {
        background: rgba(23, 37, 84, 0.97);
        box-shadow: 0 1px 14px rgba(15, 23, 42, 0.12);
        backdrop-filter: blur(12px);
      }

      .landing-nav-scrolled {
        background: rgba(23, 37, 84, 0.97);
        box-shadow: 0 1px 14px rgba(15, 23, 42, 0.12);
        backdrop-filter: blur(12px);
      }

      .landing-body nav:not(.landing-nav-scrolled) > div > div > a > span:last-child,
      .landing-body nav:not(.landing-nav-scrolled) > div > div > div button {
        color: #f7f3e9;
      }

      .mobile-nav-open {
        display: block;
      }

      .mobile-nav-closed {
        display: none;
      }

      @keyframes float-card {
        0%,
        100% { transform: translateY(0px); }
        50% { transform: translateY(-10px); }
      }

      @media (max-width: 1023px) {
        .landing-stage {
          min-height: 500px;
        }

        .landing-qr-pattern {
          right: 0;
        }

        .landing-qr-card {
          right: 0;
        }

        .landing-seat-card {
          left: 0;
        }
      }

      html {
        scroll-padding-top: 5rem;
        scroll-behavior: smooth;
      }

      body,
      .landing-body {
        background: #fff;
        color: #0f172a;
        font-family: Inter, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      }

      body {
        min-width: 0;
      }

      .landing-body main > section:not(.landing-hero) {
        background: #fff !important;
        color: #0f172a;
      }

      .landing-body main > section:not(.landing-hero)::after {
        display: none;
      }

      #how-it-works,
      #setup,
      #faq {
        background: #f8fafc !important;
      }

      #features,
      #how-it-works,
      #setup,
      #pricing,
      #faq,
      #contact {
        scroll-margin-top: 0;
        overflow: visible;
      }

      .landing-hero {
        background: linear-gradient(110deg, #fff 0%, #fff 52%, #eff6ff 100%);
      }

      .landing-grid-glow {
        opacity: 0.22;
        background-image: linear-gradient(rgba(59, 130, 246, 0.12) 1px, transparent 1px), linear-gradient(90deg, rgba(59, 130, 246, 0.12) 1px, transparent 1px);
      }

      .landing-kicker {
        color: #1d4ed8;
        letter-spacing: 0.08em;
      }

      .landing-primary-cta {
        color: #fff;
        background: #1d4ed8;
        border-radius: 0.75rem;
        box-shadow: none;
      }

      .landing-primary-cta:hover {
        background: #172554;
        transform: translateY(-1px);
      }

      .landing-secondary-cta {
        color: #172554;
        background: #fff;
        border: 1px solid #cbd5e1;
        border-radius: 0.75rem;
        box-shadow: none;
      }

      .landing-secondary-cta:hover {
        color: #1d4ed8;
        background: #eff6ff;
        border-color: #3b82f6;
        transform: translateY(-1px);
      }

      .landing-stage {
        min-height: 520px;
      }

      .landing-console {
        width: min(100%, 520px);
        border: 1px solid #cbd5e1;
        border-radius: 1rem;
        background: #172554;
        box-shadow: 0 24px 56px rgba(23, 37, 84, 0.16);
      }

      .console-topbar {
        background: #1e3a8a;
      }

      .console-content {
        background: #172554;
      }

      .console-order-card {
        background: #1e3a8a;
        border-color: rgba(147, 197, 253, 0.3);
      }

      .live-pill {
        color: #bfdbfe;
        background: rgba(59, 130, 246, 0.15);
        border-color: rgba(147, 197, 253, 0.3);
      }

      .live-pill span,
      .order-line {
        background: #f97316;
        box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.16);
      }

      .console-up,
      .table-badge,
      .seat-ring {
        color: #fff;
      }

      .console-up,
      .seat-ring {
        border-color: #f97316;
        color: #fdba74;
      }

      .table-badge {
        background: #3b82f6;
      }

      .landing-float-card {
        background: #fff;
        border-color: #e2e8f0;
        box-shadow: 0 10px 24px rgba(23, 37, 84, 0.12);
      }

      .landing-float-card p.text-white {
        color: #0f172a;
      }

      .landing-qr-pattern {
        color: #172554;
        background: #fff7ed;
        box-shadow: 0 10px 20px rgba(23, 37, 84, 0.12);
      }

      .landing-orbit {
        border-color: rgba(59, 130, 246, 0.24);
      }

      .orbit-two {
        border-color: rgba(249, 115, 22, 0.15);
      }

      .nav-shell,
      .landing-nav-scrolled {
        background: rgba(23, 37, 84, 0.97);
        box-shadow: 0 1px 14px rgba(15, 23, 42, 0.12);
        backdrop-filter: blur(12px);
      }

      .desktop-nav-link {
        color: #fff;
      }

      .desktop-nav-link:hover {
        color: #bfdbfe;
      }

      .nav-trial-cta,
      .nav-mobile-trial {
        display: inline-flex;
        min-height: 2.5rem;
        align-items: center;
        justify-content: center;
        border-radius: 0.625rem;
        background: #1d4ed8;
        padding: 0.5rem 1rem;
        color: #fff;
        font-size: 0.8125rem;
        font-weight: 700;
        transition: background 0.2s ease;
      }

      .nav-trial-cta:hover,
      .nav-mobile-trial:hover {
        background: #3b82f6;
      }

      .nav-demo-link,
      .nav-mobile-demo {
        display: inline-flex;
        min-height: 2.5rem;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.45);
        border-radius: 0.625rem;
        padding: 0.5rem 0.75rem;
        color: #fff;
        font-size: 0.8125rem;
        font-weight: 600;
      }

      .nav-demo-link:hover {
        border-color: #fdba74;
        color: #fdba74;
      }

      .nav-logo-wrap {
        border-radius: 0.5rem;
        background: #fff;
        padding: 0.125rem 0.5rem;
      }

      .nav-mobile-trial,
      .nav-mobile-demo {
        width: 100%;
      }

      .nav-mobile-demo {
        margin-top: 0.5rem;
        border-color: #cbd5e1;
        color: #172554;
      }

      .nav-mobile-demo:hover {
        background: #eff6ff;
      }

      .mobile-nav-closed {
        display: none;
      }

      .mobile-nav-open {
        display: block;
        max-height: 80vh;
        overflow-y: auto;
      }

      .feature-card {
        min-height: 0;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
      }

      .feature-card:hover {
        border-color: #bfdbfe;
        box-shadow: 0 8px 20px rgba(23, 37, 84, 0.08);
        transform: translateY(-2px);
      }

      .feature-card p {
        font-size: 0.9375rem;
      }

      .step-description {
        max-width: 15rem;
        color: #475569;
        font-size: 0.875rem;
        line-height: 1.55;
      }

      .from-brand-accent.to-brand-accent-light {
        background: #172554 !important;
      }

      .landing-body footer .text-white\/50,
      .landing-body footer .text-white\/60,
      .landing-body footer .text-white\/40 {
        color: #cbd5e1;
      }

      .footer-logo-wrap {
        width: fit-content;
        border-radius: 0.625rem;
        background: #fff;
        padding: 0.25rem 0.625rem;
      }

      :where(a, button, input, textarea, select):focus-visible {
        outline: 3px solid #3b82f6;
        outline-offset: 3px;
      }

      @media (max-width: 640px) {
        .landing-stage {
          min-height: 390px;
          margin-top: 0;
          transform: none;
        }

        .landing-console {
          width: calc(100% - 1rem);
        }

        .console-content {
          padding: 1rem;
        }

        .landing-qr-card {
          right: 0;
        }

        .landing-seat-card {
          left: 0;
        }

        .landing-primary-cta,
        .landing-secondary-cta {
          width: 100%;
          min-height: 3rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
    <script>
      const modelContext = navigator.modelContext;

      if (modelContext?.registerTool) {
        const controller = new AbortController();

        modelContext.registerTool({
          name: 'get_restaurant_management_overview',
          description: 'Get an overview of Restro360 restaurant management features.',
          inputSchema: { type: 'object', properties: {} },
          execute: async (_input, { signal } = {}) => {
            if (signal?.aborted || controller.signal.aborted) {
              throw new DOMException('The tool request was aborted.', 'AbortError');
            }

            return {
              product: 'Restro360',
              features: ['QR table ordering', 'live kitchen updates', 'GST-ready billing', 'staff accounts', 'restaurant reports'],
              contact: 'https://restro360.tech/#contact',
            };
          },
        });

        window.addEventListener('pagehide', () => controller.abort(), { once: true });
      }
    </script>
  </body>
</html>
