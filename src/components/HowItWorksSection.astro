---
const steps = [
  { label: '01 / SCAN', title: 'Scan the table', text: 'A guest scans the QR code attached to their table.' },
  { label: '02 / ORDER', title: 'Place an order', text: 'The guest browses the menu and places an order from their phone browser.' },
  { label: '03 / PREPARE', title: 'Kitchen gets the order', text: 'The order appears in the live kitchen queue, where the team updates its status.' },
  { label: '04 / SERVE & BILL', title: 'Serve and collect payment', text: 'The waiter confirms service, prepares the bill and tracks payment.' },
];
---

<section id="how-it-works" class="workflow-section" aria-labelledby="how-title">
  <div class="container">
    <header class="workflow-header">
      <p class="eyebrow">ONE CONNECTED FLOW</p>
      <h2 id="how-title">From the <em>first scan</em> to the final bill.</h2>
      <p>A single order moves through each handoff, with its status clear along the way.</p>
    </header>
    <div class="timeline-rail" data-service-timeline>
      <span class="timeline-progress" aria-hidden="true"></span>
      <ol class="timeline">
        {steps.map((step, index) => (
          <li class="timeline-step reveal">
            <span class="timeline-number mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <div class="timeline-copy">
              <span class="timeline-label mono">{step.label}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  const timeline = document.querySelector<HTMLElement>('[data-service-timeline]');
  if (timeline) {
    const steps = Array.from(timeline.querySelectorAll<HTMLElement>('.timeline-step'));
    const progress = timeline.querySelector<HTMLElement>('.timeline-progress');
    const updateProgress = () => {
      const activeIndex = steps.reduce((active, step, index) => step.classList.contains('is-visible') ? index : active, 0);
      if (!progress) return;
      if (window.matchMedia('(min-width: 768px)').matches) {
        const railRect = timeline.getBoundingClientRect();
        const firstRect = steps[0]?.getBoundingClientRect();
        const activeRect = steps[activeIndex]?.getBoundingClientRect();
        if (!firstRect || !activeRect) return;
        progress.style.left = `${firstRect.left + 17 - railRect.left}px`;
        progress.style.top = '17px';
        progress.style.width = `${Math.max(0, activeRect.left + 17 - firstRect.left)}px`;
        progress.style.height = '';
      } else {
        progress.style.width = '';
        progress.style.left = '17px';
        progress.style.top = '17px';
        progress.style.height = `${Math.max(0, (steps[activeIndex]?.offsetTop || 0) + 17)}px`;
      }
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('is-visible');
        });
        updateProgress();
      }, { threshold: 0.3 });
      steps.forEach((step) => observer.observe(step));
    } else {
      steps.forEach((step) => step.classList.add('is-visible'));
    }
    window.addEventListener('resize', updateProgress);
    updateProgress();
  }
</script>

<style>
  .workflow-section {
    padding-block: clamp(72px, calc(7vw + 16px), 104px);
  }

  .workflow-header {
    max-width: 760px;
    margin-bottom: 48px;
  }

  .workflow-header .eyebrow {
    margin-bottom: 12px;
  }

  .workflow-header h2 {
    color: #211914;
    font-size: clamp(2rem, 3.2vw, 2.875rem);
    line-height: 1.08;
  }

  .workflow-header h2 em {
    color: var(--tomato);
    font-family: var(--font-editorial);
    font-weight: 400;
  }

  .workflow-header > p:last-child {
    margin-top: 14px;
    color: #514A42;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .timeline-rail {
    max-width: 1160px;
    margin-inline: auto;
  }

  .timeline {
    gap: 24px;
  }

  .timeline-step {
    min-width: 0;
    gap: 16px;
  }

  .timeline-number {
    position: relative;
    z-index: 2;
    width: 34px;
    height: 34px;
    border: 1px solid #B7AA99;
    background: var(--ivory);
    color: #514A42;
    font-size: .75rem;
  }

  .timeline-step.is-visible .timeline-number {
    border-color: var(--tomato);
    background: var(--tomato);
    color: #FFFFFF;
  }

  .timeline-copy {
    min-width: 0;
    padding-top: 4px;
  }

  .timeline-label {
    display: block;
    margin-bottom: 8px;
    color: var(--tomato-dark);
    font-size: .68rem;
    letter-spacing: .08em;
  }

  .timeline-step h3 {
    margin: 0 0 8px;
    color: #211914;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .timeline-step p {
    max-width: 30ch;
    color: #514A42;
    font-size: .96rem;
    line-height: 1.6;
  }

  .timeline-progress {
    z-index: 1;
    background: var(--tomato);
  }

  @media (min-width: 768px) {
    .timeline {
      gap: 24px;
    }

    .timeline-step {
      display: block;
      padding-top: 52px;
    }

    .timeline-number {
      position: absolute;
      top: 0;
      left: 0;
    }
  }

  @media (max-width: 767px) {
    .workflow-section {
      padding-block: 64px;
    }

    .workflow-header {
      margin-bottom: 32px;
    }

    .timeline {
      gap: 28px;
    }

    .timeline-rail::before,
    .timeline-progress {
      top: 17px;
      bottom: 17px;
      left: 17px;
      width: 1px;
      height: auto;
    }

    .timeline-progress {
      right: auto;
      bottom: auto;
      height: 0;
    }
  }
</style>
