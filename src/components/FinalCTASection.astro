---
import { SIGNUP_URL } from '../config';
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="container">
    <div class="pre-service" aria-hidden="true">
      <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
    </div>
    <header class="final-cta-copy">
      <p class="eyebrow">THE FLOOR IS READY</p>
      <h2 id="final-cta-title">Ready for a <em>smoother service?</em></h2>
      <p>Connect QR ordering, kitchen workflow, staff roles, billing, stock, and reports in one restaurant operating system.</p>
    </header>
    <div class="final-cta-actions">
      <a class="button button-primary" href={SIGNUP_URL}>Start free for 3 months
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </a>
      <a class="button button-hero-ghost" href="#contact">Book a Free Demo
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
      </a>
    </div>
  </div>
</section>
