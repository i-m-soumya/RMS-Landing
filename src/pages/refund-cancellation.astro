---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Refund & Cancellation';
const description = 'Refund & Cancellation placeholder for Restro360';
---

<BaseLayout title={title} description={description} canonical="https://restro360.tech/refund-cancellation">
  <main class="max-w-3xl mx-auto px-4 py-20 text-brand-text">
    <h1 class="font-display text-4xl font-bold mb-6">Refund &amp; Cancellation</h1>
    <p class="text-brand-sub mb-4">TODO: Legal review required before final publication.</p>
    <p class="text-brand-sub leading-relaxed">This page is a placeholder. Please add the final refund and cancellation policy, billing terms, and support escalation process before publishing.</p>
  </main>
</BaseLayout>
