---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Privacy Policy';
const description = 'Privacy Policy placeholder for Restro360';
---

<BaseLayout title={title} description={description} canonical="https://restro360.tech/privacy-policy">
  <main class="max-w-3xl mx-auto px-4 py-20 text-brand-text">
    <h1 class="font-display text-4xl font-bold mb-6">Privacy Policy</h1>
    <p class="text-brand-sub mb-4">TODO: Legal review required before final publication.</p>
    <p class="text-brand-sub leading-relaxed">This page is a placeholder. Please add the final privacy policy language, data retention rules, cookie usage, and consent details before publishing.</p>
  </main>
</BaseLayout>
