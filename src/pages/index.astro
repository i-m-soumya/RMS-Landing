---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ProofStrip from '../components/ProofStrip.astro';
import ProductStorySection from '../components/ProductStorySection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import RolesSection from '../components/RolesSection.astro';
import PricingSection from '../components/PricingSection.astro';
import FAQSection from '../components/FAQSection.astro';
import FinalCTASection from '../components/FinalCTASection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import logoUrl from '../assets/restro360_logo.svg';
import { CONTACT_EMAIL } from '../config';

const title = 'Restro360 | Restaurant QR Ordering, Kitchen and GST Billing Software in India';
const description = 'Restro360 connects QR ordering, kitchen workflow, staff roles and GST-ready billing for restaurants in India. Launching first in Kolkata.';
const canonical = 'https://restro360.tech/';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Restro360',
      url: canonical,
      logo: new URL(logoUrl.src, canonical).href,
      email: CONTACT_EMAIL,
      areaServed: { '@type': 'City', name: 'Kolkata' },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Restro360',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      description,
      url: canonical,
      areaServed: 'India',
      audience: { '@type': 'Audience', audienceType: 'Restaurants' },
    },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <Header />
  <main id="main-content">
    <HeroSection />
    <ProofStrip />
    <ProductStorySection />
    <FeaturesSection />
    <HowItWorksSection />
    <RolesSection />
    <PricingSection />
    <FAQSection />
    <FinalCTASection />
    <ContactSection />
  </main>
  <Footer />
  <script>
    const revealItems = document.querySelectorAll('.reveal');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    revealItems.forEach((element) => element.classList.add('reveal-pending'));

    if (reducedMotion || !('IntersectionObserver' in window)) {
      revealItems.forEach((element) => element.classList.add('is-visible'));
    } else {
      const revealObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.15 });

      revealItems.forEach((element) => revealObserver.observe(element));
    }
  </script>
</BaseLayout>
