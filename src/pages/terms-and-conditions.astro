---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Terms & Conditions';
const description = 'Terms & Conditions placeholder for Restro360';
---

<BaseLayout title={title} description={description} canonical="https://restro360.tech/terms-and-conditions">
  <main class="max-w-3xl mx-auto px-4 py-20 text-brand-text">
    <h1 class="font-display text-4xl font-bold mb-6">Terms &amp; Conditions</h1>
    <p class="text-brand-sub mb-4">TODO: Legal review required before final publication.</p>
    <p class="text-brand-sub leading-relaxed">This page is a placeholder. Please add the final service terms, user responsibilities, subscription terms, and platform usage rules before publishing.</p>
  </main>
</BaseLayout>
